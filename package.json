{
  "name": "vue-reference-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.js *.json README.md",
    "security:check": "node scripts/check-secrets.mjs",
    "scss:recipes": "node scripts/build-scss-recipes.mjs",
    "prebuild": "npm run scss:recipes && npm run examples:options",
    "examples:options": "node scripts/build-options-examples.mjs",
    "pretest": "npm run examples:options"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.14",
    "@babel/parser": "^7.29.14",
    "@babel/traverse": "^7.29.14",
    "@babel/types": "^7.29.14",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/compiler-sfc": "^3.5.45",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "sass": "^1.83.0",
    "vite": "^6.0.0"
  }
}

# Copy this file to .env.local and set your own key. Never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
# Change to a structured-output model available to your account.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: choose OpenAI in the BEM tool to use this key instead of Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Code Q&A: use the same Supabase project as MyCode. Only public keys belong here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local development defaults to http://localhost:8787. Production can use the full HTTPS Supabase function URL.
VITE_VUE_ANSWER_API_URL=
